# =============================================================================
# Anna's Dog Grooming — Trust, but Verify
# Copy to .env.local. Never commit real secrets.
# Full tenant checklist: SETUP.md
# =============================================================================

# Session cookie encryption. Generate with:
#   openssl rand -hex 32
AUTH0_SECRET=replace-with-openssl-rand-hex-32

# Public origin of this app (no trailing slash). Used for Auth0 redirects
# and as the MCP resource identifier base.
APP_BASE_URL=http://localhost:3000

# Auth0 tenant domain — hostname only, no https://
# Use the demo-showcase tenant. NEVER point this at
# dev-bxdvx0t63i1hlqdi or anna-grooming.us.auth0.com.
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Regular Web Application (confidential, first-party) credentials
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# Auth0 API identifier for the MCP resource server.
# Must match the Resource Server identifier in the dashboard.
# Typical production value: https://<your-vercel-domain>/mcp
AUTH0_AUDIENCE=http://localhost:3000/mcp

# Optional override if the MCP resource URL differs from APP_BASE_URL/mcp
# MCP_SERVER_URL=http://localhost:3000/mcp

# Neon pooled connection string (?sslmode=require).
# Application traffic uses the pooler. Migrations use the direct URL.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel AI Gateway — required for the booking chatbot.
# Local: mint a key at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# On Vercel: OIDC is enough if AI Gateway is enabled on the project.
AI_GATEWAY_API_KEY=
# Optional model override (default anthropic/claude-sonnet-4.5)
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.5
